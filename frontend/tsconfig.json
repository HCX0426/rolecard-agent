{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "types": ["vite/client"],
    // shell/ 源码经 `@shell/` 别名共用（A-9 归一）：值必须与 frontend/shell-alias.ts 同 ——
    // JSON 里 import 不进 JS 常量，两处对齐由 scripts/consistency 的
    // check_pet_geometry_single_source 钉住（扫不到 ≠ 通过，与 appearance 同族）。
    "paths": {
      "@shell/*": ["../shell/main/*"]
    }
  },
  // 测试文件（src/**/*.test.tsx）与 vitest 配置也纳入类型检查：
  // vitest 用 esbuild 转译，**不做类型检查** —— 不把它们列进来，测试里的类型错误
  // 只会在运行时以"某个字段是 undefined"的形式炸出来，而不是在 `npm run build` 时被拦住。
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
