{
  "name": "rolecard-console",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 33 --cache --cache-location node_modules/.cache/eslint",
    "build": "tsc --noEmit && npm run lint && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "api:types": "openapi-typescript ../frontend/openapi.json -o src/api/schema.gen.ts",
    "api:types:migrate": "node scripts/check_handwritten_types.mjs"
  },
  "dependencies": {
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "source-map-js": "^1.2.2",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.7",
    "vitest": "^5.0.1"
  }
}
