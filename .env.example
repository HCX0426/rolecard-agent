# 复制为 .env 后填写。.env 已在 .gitignore 中，切勿提交。
# 契约归属：src/rolecard_agent/config.py —— 改这里之前先改那边。
#
# 设计目标：同一份代码支持三种部署形态（全本地 / 应用上云+模型在家 / 全云），
# 差别只在这份配置。Ollama 提供 OpenAI 兼容端点，所以"本地模型"和"云端 API"
# 在代码里是同一个 provider，只是 base_url 不同。

# --- 模型后端（按名字引用，配置与 role_card.model_name 共用这个名字） -------
# 值是一段 JSON：{后端名: {model, provider, base_url, api_key}}
# provider 默认 ollama；接云端前先装 requirements-cloud.txt，它提供 provider="openai"。
#
# 加一个云端后端只改这一行——代码不动。需要 `pip install -r requirements-cloud.txt`。
# 角色级路由靠 role_card.model_name 指向后端名：例如医疗角色留 local（数据不出门），
# 对说话风格要求高、又不碰敏感数据的角色指向 cloud。
MODEL_BACKENDS={"local":{"model":"qwen2.5vl:7b"},"cloud":{"model":"deepseek-chat","provider":"openai","base_url":"https://api.deepseek.com/v1","api_key":""}}
# 只写 model 时会继承内置 local 的 base_url（部分覆盖，不是整体替换）
# 默认后端 = local（见下）。对话模型必须是**文本版 qwen2.5:7b**：
# Ollama 官方 qwen2.5vl:7b 的模板不支持工具调用（bind_tools 直接 400），
# 带工具的「健康档案管理员」是对话主路径。vl 版图片直读/备用抽取用
# MODEL_BACKENDS 添加 name=local_vl（qwen2.5vl:7b）。
MODEL_DEFAULT=local
# 备用后端，按顺序尝试；最多 2 个（链路越长越难定位，见 docs/04 §8.5）
MODEL_FALLBACKS=
# 单次模型调用超时（秒）。不设 = 本地模型挂起时对话/抽取会无限等待，回退链也触发不了。
MODEL_TIMEOUT_SECONDS=120

# --- 存储 -----------------------------------------------------------------
SQLITE_PATH=./data/sqlite/app.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
# v2.1 RAG 嵌入后端：auto（有 SILICONFLOW_API_KEY 走 bge-m3，否则 hash 离线兜底）
RAG_EMBEDDING=auto
# 嵌入与重排共用的密钥。留空 = 嵌入退回 hash 离线兜底、重排自动关闭。
SILICONFLOW_API_KEY=
# v2.1 检索重排：auto（默认，有 key 走 bge-reranker 精排，无 key 静默关闭）/ off / siliconflow
RAG_RERANK=auto

# --- v2.3 结构化抽取（报告文本 → 指标行，domains/health/extract.py） ----------------
# 用哪个后端跑抽取模型：auto（默认，优先 provider=ollama 的本地后端 —— 报告不出本机）/
# 具体后端名（须在 MODEL_BACKENDS 里定义）。校对方会尽量换一个 provider 交叉验证。
EXTRACT_BACKEND=auto
# 抽取的第二遍（AI 校对）：auto（有不同 provider 的第二后端就交叉，否则降级为同模型
# 复查 = 弱校对，界面会如实标注）/ off（只做确定性校验与原文锚定）
EXTRACT_VERIFY=auto

# --- v2.2 OCR（图片 → 文本，独立 venv 子进程） ------------------------------------
# 本地 PaddleOCR 的解释器：指向**独立 venv** 的 python。留空 = 自动发现
# .venv-ocr/Scripts/python.exe（安装方式见 requirements-ocr.txt）。
# 必须独立 venv：paddle 自带的 numpy/OpenCV 与主环境冲突，绝不装进主环境。
OCR_PYTHON=
# 云端 OCR 兜底：仅在 Paddle 不可用**且**配置了 OCR_API_KEY 时启用（图片才会外发），
# 未配 key 则图片保持 pending，绝不悄悄外发。默认 OCR.space，无需 SDK。
OCR_BACKEND=auto
OCR_API_KEY=
OCR_PROVIDER=ocrspace
OCR_API_URL=

# --- v2.4 接入层认证（默认 off：本地演示零配置；公网部署设 on） ------------------------
# off = 不校验 | auto = 回环地址放行、外部要求（会看 X-Forwarded-For）| on = 一律要求
AUTH_MODE=off
# Basic 凭证，格式 "user:pass"，多个用逗号分隔。浏览器会弹原生登录框，前端无需改动。
AUTH_CREDENTIALS=
# API Key 列表（逗号分隔），给脚本 / CI / 监控用，请求头 X-API-Key。
# 审计日志只记 key 前 4 位，不落完整凭证。
AUTH_API_KEYS=
# 豁免路径前缀（逗号分隔）—— /api/health 必须豁免，否则容器探活永远 401
AUTH_EXEMPT_PATHS=/api/health

# --- 可观测 ---------------------------------------------------------------
# local（默认，纯本地 JSON 日志，离线可用） | langsmith | langfuse
OBS_BACKEND=local
# 留空 = 写到 stderr；填路径则追加 JSON 行到该文件
OBS_LOG_PATH=
# 仅当 OBS_BACKEND=langsmith 且填写 key 时才会上传
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rolecard-agent
# false（默认）= 脱敏：trace 里只记录 thread_id / 角色 / 节点 / 工具名 / 耗时 / token，
#                报告原文与指标值一律不外发
# true          = 允许把原文与指标值写进 trace（仅在全虚构演示数据时可开）
OBS_EMIT_RAW_TEXT=false
