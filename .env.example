# 复制为 .env 后填写。.env 已在 .gitignore 中，切勿提交。
# 契约归属：src/rolecard_agent/config.py —— 改这里之前先改那边。
#
# 设计目标：同一份代码支持三种部署形态（全本地 / 应用上云+模型在家 / 全云），
# 差别只在这份配置。Ollama 提供 OpenAI 兼容端点，所以"本地模型"和"云端 API"
# 在代码里是同一个 provider，只是 base_url 不同。

# --- 模型后端（按名字引用，配置与 role_card.model_name 共用这个名字） -------
# 值是一段 JSON：{后端名: {model, provider, base_url, api_key}}
# provider 默认 ollama；接云端前先装 requirements-cloud.txt，它提供 provider="openai"。
#
# 加一个云端后端只改这一行——代码不动。需要 `pip install -r requirements-cloud.txt`。
# 角色级路由靠 role_card.model_name 指向后端名：例如医疗角色留 local（数据不出门），
# 对说话风格要求高、又不碰敏感数据的角色指向 cloud。
MODEL_BACKENDS={"local":{"model":"qwen2.5:7b"},"cloud":{"model":"deepseek-chat","provider":"openai","base_url":"https://api.deepseek.com/v1","api_key":""}}
# 只写 model 时会继承内置 local 的 base_url（部分覆盖，不是整体替换）
MODEL_DEFAULT=local
# 备用后端，按顺序尝试；最多 2 个（链路越长越难定位，见 docs/04 §8.5）
MODEL_FALLBACKS=

# --- 存储 -----------------------------------------------------------------
SQLITE_PATH=./data/sqlite/app.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads

# --- 可观测 ---------------------------------------------------------------
# local（默认，纯本地 JSON 日志，离线可用） | langsmith | langfuse
OBS_BACKEND=local
# 留空 = 写到 stderr；填路径则追加 JSON 行到该文件
OBS_LOG_PATH=
# 仅当 OBS_BACKEND=langsmith 且填写 key 时才会上传
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rolecard-agent
# false（默认）= 脱敏：trace 里只记录 thread_id / 角色 / 节点 / 工具名 / 耗时 / token，
#                报告原文与指标值一律不外发
# true          = 允许把原文与指标值写进 trace（仅在全虚构演示数据时可开）
OBS_EMIT_RAW_TEXT=false
