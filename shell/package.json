{
  "name": "rolecard-shell",
  "productName": "rolecard-agent",
  "private": true,
  "version": "0.6.2",
  "description": "rolecard-agent 桌面壳（Electron）：窗口 + 本地后端进程生命周期 + 原生能力桥。不含第二份 UI。",
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:cleanup": "npm run build && node scripts/test-update-cache-cleanup.cjs",
    "test:dock": "npm run build && node scripts/test-pet-dock-geometry.cjs",
    "test:feedback": "npm run build && node scripts/test-update-feedback.cjs",
    "test:navigation": "npm run build && node scripts/test-navigation-guard.cjs",
    "package:dir": "npm run build && electron-builder --win --dir",
    "package": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^24",
    "electron": "^44",
    "electron-builder": "^26.18.1",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "@electron/asar": {
      ".": "^4.3.1",
      "glob": "^14.0.2"
    },
    "@electron/universal": "^3.0.6"
  }
}
