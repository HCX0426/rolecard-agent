{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rolecard-agent",
  "version": "0.1.0",
  "identifier": "cn.rolecard.shell",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rolecard-agent",
        "width": 1240,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}
