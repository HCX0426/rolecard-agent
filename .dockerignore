# 版本控制与本地垃圾不进镜像
.git
.gitignore
.venv*
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache

# 运行时数据：挂卷，不打包（NEVER commit / bake health records）
data

# 前端源码与依赖（镜像只要 dist 产物）
frontend/node_modules
frontend/src
frontend/package*.json
frontend/vite.config.ts
frontend/tsconfig.json
frontend/index.html

# 文档与评测（镜像不需要）
docs
tests
CONTRIBUTING.md
README.md
