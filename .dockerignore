# 版本控制与本地垃圾不进镜像
.git
.gitignore
.venv*
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache

# 运行时数据：挂卷，不打包（NEVER commit / bake health records）
data

# 前端源码与依赖（镜像只要 dist 产物）
frontend/node_modules
frontend/src
frontend/package*.json
frontend/vite.config.ts
frontend/tsconfig.json
frontend/index.html

# 文档与评测（镜像不需要）
docs
tests
CONTRIBUTING.md
README.md

# 构建产物与打包链（R28-28：这一块此前完全没排除，每次 docker build 白传 ~1 GB）
# `build/` 里不只有体积：随包后端的 sidecar、探针库副本与那份真库备份 zip 都在里面 ——
# **她的健康数据与对话**。Dockerfile 目前是选择性 COPY（`src`/`frontend/dist`/`scripts`/
# requirements），所以这些并没有进镜像；但上下文照样整包发给 daemon，而将来任何人把这里
# 改成 `COPY . .` 就会一次性把它烤进镜像。这条排除是**防那一次改动**，不是防今天。
build
shell
node_modules
*.egg-info
# 本机密钥与本地形态配置：容器一律走环境变量，不进上下文、不进镜像层。
.env
.env.*
*.log
*.zip
