# --- secrets / local config ---
.env
.env.local

# --- runtime data (NEVER commit health records) ---
data/sqlite/*.db
data/sqlite/*.db-journal
data/sqlite/*.db-shm
data/sqlite/*.db-wal
# 迁移前手搓的库备份（里面和 app.db 一样是真实数据与凭据，同样绝不入库）
data/sqlite/*.bak
# retention「先备份再删」落的那些 JSONL：内容就是被删的审计行与命令行原文，
# 和 app.db 同一等级密（开发态数据根就是仓库 data/），绝不入库、随整目录升级不碰
data/retention-backups/*
# 文件工具（fs_write）与命令执行的默认工作区：装的是用户让它写出来的东西，不是素材
# （这一格是 10-03 新断言 `data root dirs are gitignored` 上线第一次运行照出来的）
data/workspace/*
# keep the directory, ignore its contents (same pattern as uploads/ below)
data/chroma/*
!data/chroma/.gitkeep
data/uploads/*
# 用户外挂的桌宠素材（含 Cubism Core 运行时）不入库：
# 那些东西的来源与条款由放它的人负责，而安装包是整目录替换、升级不该碰到它们。
data/pets/*
!data/pets/.gitkeep
!data/uploads/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# 覆盖率产物：数据是本地的，CI 每次自己生成
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- frontend ---
# 构建产物 dist/ 有意提交：clone 后不需要 node 环境就能跑控制台演示。
frontend/node_modules/
# 兜底：任何层级的 node_modules（含 Vite 依赖预打包缓存 node_modules/.vite，Vite 会在仓库根生成）
node_modules/
# tsc 的增量缓存（`tsc --noEmit` 在 composite 工程里顺手写这一份）：机器相关、每次构建都变，
# 而它不是产物 —— 上面说了，有意入库的那一份是 dist。
*.tsbuildinfo

# --- eval ---
# 每次跑批都会重写（模型相关，数字会漂移）；基线数字固化在 docs/需求与验收标准.md
tests/eval/report.json
# 无模型时的跑批链路自检产物（同理由脚本生成，不入库）
tests/eval/harness/
# 指定 --report 落到 data/ 的基线报告同样是临时件（数字已固化进 docs/需求与验收标准.md）
data/eval_*.md

# --- models / large artifacts ---
models/
*.onnx
*.pdmodel
*.pdparams

# --- ide / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- demos / media (a 60s screen recording is tens of MB - keep it out of the repo) ---
*.mp4
*.mov
*.webm
*.gif
!docs/assets/*.gif

# --- ad-hoc UI probe scripts (throwaway; keep the dir clean) ---
scripts/_*.js

# --- 打包中间产物（D②-4）：PyInstaller 的 onedir 有几百 MB，永远不入库，安装包现打 ---
/build/
data/sqlite/*.trace.jsonl

# 开发态数据根里被隔离出来的陈旧快照（2026-09-25，见审计 §12.19 那条数据根分叉）
data/sqlite/_stale-dev-snapshot-*/
build/_baseline/

# --- zcode tooling ---
# .zcodeignore 是 .gitignore 的工具派生件（上半部由 ZCode 自动同步重写）：入库等于第二份事实，
# 且每次同步都产生噪音 diff —— 保持本地（2026-10-02 拍板，见架构审计 2026-10-02 轮 H6）。
.zcodeignore
